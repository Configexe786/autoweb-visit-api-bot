{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/keep-alive",
      "dest": "api/index.py"
    },
    {
      "src": "/",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 */4 * * *"
    }
  ]
}
